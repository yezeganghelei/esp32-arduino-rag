# ── ESP32 RAG Environment Variables Template ───────────────────────
#
# Copy this file to .env and adjust values as needed.
# docker-compose automatically reads .env in the same directory.
#
# Usage:
#   cp .env.example .env
#   # edit .env
#   docker-compose up -d

# ── Model offline mode ─────────────────────────────────────────────
# Keep these as 1 �?all models are bundled locally.
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1

# ── Paths inside the container ─────────────────────────────────────
# These usually don't need changing since volumes are mounted here.
RAG_CHROMA_DIR=/app/.chroma_esp32_all
RAG_DOCS_DIR=/app/source

# ── Code index (optional) ──────────────────────────────────────────
# Uncomment to enable source-code index (see config.yaml `code:` block)
# RAG_INDEX_CODE=1
# RAG_CODE_CHROMA_DIR=/app/.chroma_esp32_code
# RAG_CODE_DOCS_DIR=/app/source_code

# ── LLM API (for chat / RAG generation) ────────────────────────────
# Required for the chatbot feature. Supports any OpenAI-compatible API.
#
# DeepSeek (recommended for Chinese technical Q&A):
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
#
# SiliconFlow (硅基流动) �?many models available:
# LLM_API_KEY=
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3
#
# OpenAI:
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ── Server config ──────────────────────────────────────────────────
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000

# ── Web UI (Gradio) ────────────────────────────────────────────────
# The Gradio web chat interface connects to the API backend.
# API_BASE_URL=http://localhost:8000
# WEB_HOST=0.0.0.0
# WEB_PORT=7860
